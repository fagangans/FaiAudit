# Supabase (project: FaiAudit)
SUPABASE_URL=https://xovcyjpxynewruixpdbp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # ambil dari Supabase Dashboard > Project Settings > API (jangan commit nilai asli)
SUPABASE_ANON_KEY=  # ambil dari Supabase Dashboard > Project Settings > API > anon/public

# Akun master (satu-satunya yang bisa login langsung; master mendaftarkan
# client lewat menu Pengaturan di dashboard). Ganti password ini.
MASTER_EMAIL=
MASTER_PASSWORD=

# Server
PORT=3000

# AI provider untuk analisis chat: "scraper" (gratis/default, pakai Google Gemini) atau "qwen" (OpenRouter)
AI_PROVIDER=qwen
OPENROUTER_API_KEY=
QWEN_MODEL=qwen/qwen-2.5-72b-instruct

# Provider default ("scraper"/"AI Biasa (Cepat)" di dropdown Pengaturan):
# Google Gemini lewat Google AI Studio (gratis, kuota harian). Kalau kuota
# habis (429), otomatis fallback ke model OpenRouter murah di bawah (butuh
# OPENROUTER_API_KEY di atas tetap diisi).
GEMINI_API_KEY=  # ambil dari https://aistudio.google.com/apikey (jangan commit nilai asli)
GEMINI_MODEL=gemini-1.5-flash
AI_FALLBACK_MODEL=google/gemini-2.0-flash-001

# Dashboard monitoring (uptime + keamanan seluruh web Fagan)
UPTIME_CHECK_INTERVAL_MS=300000  # 5 menit; ubah kalau mau lebih jarang/sering
# Token statis untuk endpoint /api/monitoring-ingest/security/ingest — dipakai
# skrip audit OWASP terjadwal (bukan sesi browser). Generate sendiri, misal:
# openssl rand -hex 32 — dan JANGAN commit nilai asli.
MONITOR_INGEST_TOKEN=
# URL publik endpoint ingest itu (dipakai server saat "Aktifkan Audit Mandiri"
# men-set secret MONITOR_INGEST_URL di repo target). Contoh:
MONITOR_INGEST_URL=https://audit.faiagent.my.id/api/monitoring-ingest/security/ingest

# Personal Access Token GitHub (fine-grained) khusus untuk fitur "Aktifkan
# Audit Mandiri" di halaman Kelola Target — dipakai server memasang
# self-audit-kit (file + 2 secret) ke repo target lewat GitHub API.
# Cara buat: GitHub -> Settings -> Developer settings -> Personal access
# tokens -> Fine-grained tokens -> New token.
#   - Resource owner: akun/organisasi pemilik repo-repo Fagan
#   - Repository access: "Only select repositories" -> pilih repo yang relevan
#     saja (JANGAN "All repositories")
#   - Permissions: Contents = Read and write, Secrets = Read and write
# JANGAN commit nilai token asli. Kalau bocor, revoke & buat baru di GitHub.
GITHUB_PAT=
